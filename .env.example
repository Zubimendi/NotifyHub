DATABASE_URL=postgresql+asyncpg://notifyhub:notifyhub@localhost:5432/notifyhub
REDIS_URL=redis://localhost:6379/0
HTTP_PORT=8000

# QueueLine — retry/backoff scheduling for individual provider-attempt
# jobs is delegated there, not rebuilt here. See docs/ARCHITECTURE.md §6.
QUEUELINE_BASE_URL=http://localhost:8081
QUEUELINE_DISPATCH_QUEUE=notify-dispatch

# Provider chains, ordered, comma-separated — reordering/adding/removing
# a provider here touches no application code. See docs/ARCHITECTURE.md §7.
EMAIL_PROVIDER_CHAIN=http://localhost:9101,http://localhost:9102
SMS_PROVIDER_CHAIN=http://localhost:9103
PUSH_PROVIDER_CHAIN=http://localhost:9104
PROVIDER_TIMEOUT_MS=3000
MAX_SAME_PROVIDER_RETRIES=3

# Digest batching
DEFAULT_DIGEST_WINDOW_MINUTES=60
DIGEST_SWEEP_INTERVAL_MS=15000
FLUSHING_STUCK_TIMEOUT_SECONDS=300

# Stateless unsubscribe-link signing — deliberately minimal, see
# docs/ARCHITECTURE.md and docs/CURSOR_CONTEXT.md §9.
UNSUBSCRIBE_TOKEN_SECRET=dev-secret-change-me
